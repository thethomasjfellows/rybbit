# Copy to /etc/rybbit-backup.env on the Rybbit application host and chmod 600.

BACKUP_HOST=rybbit

POSTGRES_CONTAINER=postgres
POSTGRES_DATABASE=analytics
POSTGRES_STAGING_ROOT=/var/backups/rybbit/postgres
POSTGRES_RCLONE_REMOTES=rybbit_r2:rybbit-backups/postgres/analytics

# The all-in-one RackNerd host also runs ClickHouse. File mode creates a native
# archive in its existing Docker volume, then uploads and verifies it through
# rclone without changing ClickHouse configuration or restarting the service.
CLICKHOUSE_CONTAINER=clickhouse
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_BACKUP_MODE=file
CLICKHOUSE_FILE_BACKUP_ROOT=/var/lib/docker/volumes/rybbit_clickhouse-data/_data/backups
CLICKHOUSE_STAGING_ROOT=/var/backups/rybbit/clickhouse
CLICKHOUSE_RCLONE_REMOTES=rybbit_r2:rybbit-backups/clickhouse/analytics

# POSTGRES_SUCCESS_URL=
# POSTGRES_FAILURE_URL=
